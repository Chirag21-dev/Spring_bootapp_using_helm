pipeline {
    agent any
     tools {
    
        maven 'Maven-3.9'
    }
    environment {
        ECR_REGISTRY = '034362060941.dkr.ecr.us-east-1.amazonaws.com'
        K8S_NAMESPACE = 'devops'
        HELM_RELEASE   = 'my-application'
        HELM_CHART     = 'helm/my-docker-repo'
        ECR_REPO='my-docker-repo'
    }

  
    stages {
        stage('Checkout') {
            steps {
                checkout scmGit(branches: [[name: '*/main']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/chirag21-dev/Spring-bootapp_using_helm.git']])
            }
        }

       stage('Compile') {
            steps {
                sh 'mvn compile'
            }
        }
        
        stage ("Build JAR") {
            steps {
                sh "mvn clean install"
            }
        }

       stage('Docker Build') {
        steps {
        sh '''
            docker build \
                -t 034362060941.dkr.ecr.us-east-1.amazonaws.com/my-docker-repo:${BUILD_NUMBER} \
                -t 034362060941.dkr.ecr.us-east-1.amazonaws.com/my-docker-repo:latest \
                .
        '''
    }
}

stage('Login to ECR') {
            steps {
                sh '''
                    aws sts get-caller-identity

                    aws ecr get-login-password --region us-east-1 | \
                    docker login --username AWS --password-stdin 034362060941.dkr.ecr.us-east-1.amazonaws.com
                '''
            }
        }
stage('Push to ECR') {
    steps {
        sh '''
            docker push 034362060941.dkr.ecr.us-east-1.amazonaws.com/my-docker-repo:${BUILD_NUMBER}
            docker push 034362060941.dkr.ecr.us-east-1.amazonaws.com/my-docker-repo:latest
        '''
    }
}
stage('Configure Kubernetes') {
            steps {
                sh '''
                    kubectl cluster-info

                    kubectl create namespace ${K8S_NAMESPACE} \
                    --dry-run=client -o yaml | kubectl apply -f -

                    ECR_PASSWORD=$(aws ecr get-login-password \
                    --region us-east-1

                    kubectl create secret docker-registry ecr-secret \
                    --namespace ${K8S_NAMESPACE} \
                    --docker-server=${ECR_REGISTRY} \
                    --docker-username=AWS \
                    --docker-password="${ECR_PASSWORD}" \
                    --dry-run=client -o yaml | kubectl apply -f -

                    unset ECR_PASSWORD
                '''
            }
        }

stage('Helm Chart Validation') {
            steps {
                sh '''
                    helm lint ${HELM_CHART}

                    helm template ${HELM_RELEASE} ${HELM_CHART} \
                    --namespace ${K8S_NAMESPACE} \
                    --set-string image.tag=${IMAGE_TAG} \
                    --set fullnameOverride=${HELM_RELEASE}
                '''
            }
        }
 stage('Deploy using Helm') {
            steps {
                sh '''
                    helm upgrade --install ${HELM_RELEASE} ${HELM_CHART} \
                    --namespace ${K8S_NAMESPACE} \
                    --set-string image.repository=${ECR_REGISTRY}/${ECR_REPO} \
                    --set-string image.tag=${IMAGE_TAG} \
                    --set fullnameOverride=${HELM_RELEASE} \
                    --wait \
                    --timeout 5m
                '''
            }
        }


}
 post {
        success {
            echo "Application successfully deployed using Helm!"
            echo "Docker Image: ${ECR_REGISTRY}/${ECR_REPO}:${BUILD_NUMBER}"
        }

        failure {
            echo 'Pipeline failed. Check Jenkins console output.'
        }
    }
}
